			"version" : "0",
			"release_note" : "<div style=\"font:Arial, Helvetica, sans-serif; padding:10px; border:#8fafda 2px dashed; background:#f1f8fe;\" >\n  <div>\n    <h4 style=\"color:#184f88;\"><b class=\"type_13_en\">\u64cd\u4f5c\u8aaa\u660e\uff1a</b></h4>\n    <ol>\n      <li>\u4e0b\u8f09\u8a9e\u97f3\u66f4\u65b0\u8edf\u9ad4\uff0c\u4e26\u5132\u5b58\u5230\u60a8\u96fb\u8166\u7684\u786c\u789f\u4e0a\u3002</li>\n      <li>\u5c07GPS \u4e3b\u6a5f\u900f\u904eUSB\u7dda\u9023\u63a5\u4e0a\u96fb\u8166\uff0cGPS\u4e3b\u6a5f\u87a2\u5e55\u82e5\u6709\u51fa\u73fe\u300c\u5075\u6e2c\u5230USB\u9023\u7dda\u300d\uff0c\u8acb\u9ede\u9078\u300c\u96a8\u8eab\u789f\u6a21\u5f0f\u300d\u3002</li>\n      <li>\u8acb\u5728\u66f4\u65b0\u524d\u78ba\u8a8dGPS\u6a5f\u53f0\u7684\u96fb\u529b\u662f\u5426\u5145\u8db3(\u8acb\u4fdd\u6301\u4e09\u683c\u96fb\u529b\u4ee5\u4e0a) </li>\n      <li>\u65bc\u96fb\u8166\u4e0a\u57f7\u884c\u6240\u4e0b\u8f09\u7684\u66f4\u65b0\u8edf\u9ad4\uff0c\u4e26\u4f9d\u7167\u66f4\u65b0\u8edf\u9ad4\u6240\u6307\u793a\u7684\u6b65\u9a5f\u64cd\u4f5c\u3002 </li>\n      <li>\u66f4\u65b0\u8edf\u9ad4\u5c07\u6703\u81ea\u52d5\u5075\u6e2c\u60a8\u7684GPS\u4e3b\u6a5f\uff0c\u6216\u53ef\u624b\u52d5\u9ede\u9078\u300e\u641c\u5c0b\u88dd\u7f6e\u300f\u641c\u5c0b\u5230\u60a8\u7684GPS\u4e3b\u6a5f\u5f8c\uff0c\u5373\u53ef\u50b3\u9001\u5347\u7d1a\u8edf\u9ad4\u81f3GPS\u6a5f\u53f0\u4e2d\u3002 </li>\n      <li>\u7576\u66f4\u65b0\u8edf\u9ad4\u986f\u793a\u300e\u5b8c\u6210\u300f\u5f8c\uff0c\u79fb\u9664GPS\u4e3b\u6a5f\u8207\u96fb\u8166\u7684\u9023\u7dda\u3002 <br>\n        </li>\n      <li>\u7576\u5b8c\u6210\u66f4\u65b0\u7a0b\u5e8f\u5f8c\uff0cGPS\u5c07\u6703\u91cd\u65b0\u8a2d\u5b9a\u8207\u6b63\u5e38\u958b\u6a5f\u3002 </li>\n      </p>\n    </ol>\n  </div>\n  <p>&nbsp;</p>\n  <div id=\"spec\">\n    <h4 style=\"color:#184f88;\"><b class=\"type_13_en\">\u67e5\u770b\u8a9e\u97f3\u7248\u672c\uff0c\u5176\u6b65\u9a5f\u5982\u4e0b\uff1a</b>    </h4>\n       <table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"2\"  >\n          <tr>\n            <td align=\"right\">nuvi35XX \uff1a</td>\n            <td height=\"30\">\u958b\u6a5f\u5f8c\uff0c\u9ede\u9078 <strong>\u8a2d\u5b9a</strong> > <strong>\u88dd\u7f6e</strong> > \u95dc\u65bc \u5167\u7684<strong>\u300c\u8a9e\u97f3\u7248\u672c\u300d</strong>\u3002 </td>\n          </tr>\n          <tr>\n            <td align=\"right\">nuvi25XX\uff1a</td>\n            <td height=\"30\">\u958b\u6a5f\u5f8c\uff0c\u9ede\u9078 <strong>\u5de5\u5177</strong> > <strong>\u8a2d\u5b9a</strong> > <strong>\u7cfb\u7d71</strong> > \u95dc\u65bc \u5167\u7684\u300c<strong>\u97f3\u8a0a\u7248\u672c\u300d\u3002</strong></td>\n          </tr>\n          <tr>\n            <td align=\"right\">nuvi1XXX\uff1a</td>\n            <td height=\"30\">\u958b\u6a5f\u5f8c\uff0c\u9ede\u9078 <strong>\u5de5\u5177</strong> &gt; <strong>\u8a2d\u5b9a</strong> &gt; <strong>\u7cfb\u7d71</strong> &gt; \u95dc\u65bc &gt; \u8edf\u9ad4\u7248\u672c \u5167\u7684<strong>\u300c\u8a9e\u97f3\u7248\u672c\u300d\u3002</strong></td>\n          </tr>\n          <tr>\n            <td align=\"right\">nuvi 40 / 50\uff1a </td>\n            <td height=\"30\">\u958b\u6a5f\u5f8c\uff0c\u9ede\u9078 <strong>\u8a2d\u5b9a</strong> &gt; <strong>\u7cfb\u7d71</strong> &gt; <strong>\u95dc\u65bc</strong> &gt; \u8edf\u9ad4\u7248\u672c \u5167\u7684\u300c<strong>\u8a9e\u97f3\u7248\u672c\u300d\u3002</strong></td>\n          </tr>\n        </table>\n    <p>&nbsp;</p>\n  </div>\n<div>\n    <h4 style=\"color:#C00;\">\u6ce8\u610f\u4e8b\u9805\uff1a</h4>\n    <ol>\n      <li>\u6b64\u8edf\u9ad4\u66f4\u65b0\u7684\u96fb\u8166\u4f5c\u696d\u7cfb\u7d71\u9700\u6c42\u70baMicrosoft Windows 2000/NT/XP/Vista/7(32\u4f4d\u5143)\u3002        </li>\n      <li>\u8acb\u5148\u79fb\u9664\u6a5f\u53f0\u88e1\u7684\u8a18\u61b6\u5361\u6216\u5176\u4ed6\u672a\u4f7f\u7528\u7684USB\u78c1\u789f\u6a5f\u3002\u5047\u4f7f\u60a8\u6240\u4e0b\u8f09\u7684\u4e0d\u662f\u60a8GPS\u6a5f\u7a2e\u6240\u9069\u7528\u7684\u66f4\u65b0\u8edf\u9ad4\uff0c\u5247\u5c07\u7121\u6cd5\u64cd\u4f5c\u517