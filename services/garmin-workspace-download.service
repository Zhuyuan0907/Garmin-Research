[Unit]
Description=Garmin reverse engineering workspace LAN download
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
User=garmin-workspace-download
RuntimeDirectory=garmin-workspace-download
BindReadOnlyPaths=/root/garmin/reports/downloads:/run/garmin-workspace-download/downloads
ExecStart=/usr/bin/python3 -B -u /usr/local/lib/garmin-workspace-download/server.py --host 172.16.60.187 --port 8766 --archive /run/garmin-workspace-download/downloads/GarminOS-2565RT-research-v1.zip
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=tmpfs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
