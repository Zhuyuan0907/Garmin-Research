<?xml version='1.0' encoding='UTF-8'?>
<GARMIN_MAP_THEME>
  <METADATA>
    <TITLE>Pi Contrast</TITLE>
    <DESCRIPTION>High contrast day and night map colours, prepared from this device's own theme.</DESCRIPTION>
    <Version><Major>2</Major><Minor>30</Minor></Version>
  </METADATA>

  <PRESENTATION ID="Guidance">

    <STYLELIST>

      <STYLE field="MAP_BEACH_CLR">
        <COLOR>
          <PRIMARY day="#E8C455" night="#67491D" />
        </COLOR>
      </STYLE>

      <STYLE field="MAP_BUILDING_CLR">
        <COLOR>
          <PRIMARY day="#ECECC4" night="#26003B" />
        </COLOR>
      </STYLE>

      <STYLE field="MAP_BUILDING_SHADOW_CLR">
        <COLOR>
          <PRIMARY day="#C8C8A7" night="#3B005A" />
        </COLOR>
      </STYLE>

      <STYLE field="MAP_EXTRD_AREA_CLR">
