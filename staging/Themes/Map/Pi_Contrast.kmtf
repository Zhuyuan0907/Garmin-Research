          <PRIMARY day="#788181" night="#323F48" />
        </COLOR>
      </STYLE>

      <STYLE field="MAP_GLACIER_CLR">
        <COLOR>
          <PRIMARY day="#FFFFFF" night="#808080" />
        </COLOR>
      </STYLE>

      <STYLE field="MAP_LAND_CLR">
